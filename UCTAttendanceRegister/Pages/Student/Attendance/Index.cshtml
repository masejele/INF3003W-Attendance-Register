@page
@model UCTAttendanceRegister.Pages.Student.Attendance.IndexModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Student")]

@{
    ViewData["Title"] = "My Attendance";
}

<div class="page-intro">
    <span class="eyebrow">Records</span>
    <h1 class="page-title student-title">My Attendance</h1>
    <p>Here you can view your INF3003W attendance history.</p>
</div>

<div class="page-actions">
    <a href="/Student/Index" class="btn btn-primary">Back to Dashboard</a>
</div>

@if (Model.AttendanceRows.Count == 0)
{
    <div class="alert alert-info">
        You do not have any INF3003W attendance sessions yet.
    </div>
}
else
{
    <div class="table-shell">
        <table class="table">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Date</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Marked At</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.AttendanceRows)
                {
                    <tr>
                        <td>@row.CourseCode</td>
                        <td>@row.SessionDate.ToString("dd/MM/yyyy")</td>
                        <td>@row.StartTime.ToString(@"hh\:mm")</td>
                        <td>@row.EndTime.ToString(@"hh\:mm")</td>
                        <td>@(row.MarkedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        <td>
                            @if (row.IsPresent)
                            {
                                <span class="badge bg-success">Present</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Absent</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
