@page
@model UCTAttendanceRegister.Pages.Student.Profile.IndexModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Student")]

<div class="page-intro">
    <span class="eyebrow">Profile</span>
    <h1 class="page-title student-title">My Profile</h1>
</div>

<div class="page-actions">
    <a href="/Student/Index" class="btn btn-primary">
        Back to Dashboard
    </a>
</div>

<div class="glow-panel" style="max-width: 750px;">
    <h2>Student Information</h2>

    <hr />

    <p>
        <strong>Name:</strong>
        @Model.CurrentUser?.FullName
    </p>

    <p>
        <strong>Email:</strong>
        @Model.CurrentUser?.Email
    </p>

    <p>
        <strong>Student Number:</strong>
        @Model.CurrentUser?.StudentNumber
    </p>

    <a href="/Student/Index" class="btn btn-primary">
        Back to Dashboard
    </a>
</div>