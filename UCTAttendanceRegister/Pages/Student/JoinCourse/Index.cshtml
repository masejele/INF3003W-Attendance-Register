@page
@model UCTAttendanceRegister.Pages.Student.JoinCourse.IndexModel
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Student")]

@{
    ViewData["Title"] = "Join Course";
}

<div class="page-intro">
    <span class="eyebrow">Enrollment</span>
    <h1 class="page-title student-title">Join a Course</h1>
    <p>Join the INF3003W class.</p>
</div>

<div class="page-actions">
    <a href="/Student/Index" class="btn btn-primary">
        Back to Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card glow-panel">
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label class="form-label">Course</label>
                        <p class="form-control-plaintext">INF3003W</p>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Join INF3003W</button>
                </form>
            </div>
        </div>
    </div>
</div>
