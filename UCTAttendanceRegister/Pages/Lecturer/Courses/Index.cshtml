@page
@model UCTAttendanceRegister.Pages.Lecturer.Courses.IndexModel

@{
    ViewData["Title"] = "Courses";
}

<div class="page-intro">
    <span class="eyebrow">Curriculum</span>
    <h1 class="page-title lecturer-title">My Courses</h1>
</div>

<div class="page-actions">
    <a href="/Lecturer/Index" class="btn btn-primary">
        Back to Dashboard
    </a>
</div>

<div class="page-actions">
    <a asp-page="Create" class="btn btn-primary">Create New Course</a>
</div>

@if (Model.Courses.Any())
{
    <div class="table-shell">
        <table class="table">
            <thead>
                <tr>
                    <th>Course Code</th>
                    <th>Course Name</th>
                    <th>Enrollment Code</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var course in Model.Courses)
                {
                    <tr>
                        <td>@course.CourseCode</td>
                        <td>@course.CourseName</td>
                        <td><code>@course.EnrollmentCode</code></td>
                        <td>
                            <a asp-page="Edit"
                               asp-route-id="@course.Id"
                               class="btn btn-sm btn-secondary">
                                Edit
                            </a>

                            <a asp-page="Delete"
                               asp-route-id="@course.Id"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

}
else
{
    <div class="glow-panel">
        <p>You currently have no courses.</p>
    </div>
}