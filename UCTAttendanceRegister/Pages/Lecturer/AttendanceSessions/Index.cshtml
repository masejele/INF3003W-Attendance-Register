@page
@model UCTAttendanceRegister.Pages.Lecturer.AttendanceSessions.IndexModel

@{
    ViewData["Title"] = "Attendance Sessions";
}

<div class="page-intro">
    <span class="eyebrow">Sessions</span>
    <h1 class="page-title lecturer-title">Attendance Sessions</h1>
</div>

<div class="page-actions">
    <a href="/Lecturer/Index" class="btn btn-primary">
        Back to Dashboard
    </a>
</div>

<div class="page-actions">
    <a asp-page="Create" class="btn btn-primary">
        Create New Session
    </a>
</div>

@if (Model.AttendanceSessions.Any())
{
    <div class="table-shell">
        <table class="table">
            <thead>
                <tr>
                    <th>Course</th>
                    <th>Date</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var session in Model.AttendanceSessions)
                {
                    <tr>
                        <td>
                            @session.Course?.CourseCode
                        </td>

                        <td>
                            @session.SessionDate.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @session.StartTime.ToString(@"hh\:mm")
                        </td>

                        <td>
                            @session.EndTime.ToString(@"hh\:mm")
                        </td>

                        <td>
                            @if (session.IsOpen)
                            {
                                <span class="badge bg-success">
                                    Open
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Closed
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-page="./Edit"
                               asp-route-id="@session.Id"
                               class="btn btn-sm btn-secondary">
                                Edit
                            </a>

                            <form method="post" asp-page-handler="Delete" style="display:inline;">
                                <input type="hidden" name="id" value="@session.Id" />

                                <button type="submit" class="btn btn-sm btn-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

}
else
{
    <div class="glow-panel">
        <p>No attendance sessions have been created yet.</p>
    </div>
}