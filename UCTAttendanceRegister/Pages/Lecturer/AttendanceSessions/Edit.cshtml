@page "{id:int}"
@model UCTAttendanceRegister.Pages.Lecturer.AttendanceSessions.EditModel

@{
    ViewData["Title"] = "Edit Attendance Session";
}

<h1>Edit Attendance Session</h1>

<form method="post">

    <input type="hidden" asp-for="AttendanceSession.Id" />

    <div class="mb-3">
        <label asp-for="AttendanceSession.SessionDate" class="form-label">
            Session Date
        </label>

        <input asp-for="AttendanceSession.SessionDate"
               class="form-control"
               type="date" />

        <span asp-validation-for="AttendanceSession.SessionDate"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AttendanceSession.StartTime" class="form-label">
            Start Time
        </label>

        <input asp-for="AttendanceSession.StartTime"
               class="form-control"
               type="time" />

        <span asp-validation-for="AttendanceSession.StartTime"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AttendanceSession.EndTime" class="form-label">
            End Time
        </label>

        <input asp-for="AttendanceSession.EndTime"
               class="form-control"
               type="time" />

        <span asp-validation-for="AttendanceSession.EndTime"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-page="./Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}